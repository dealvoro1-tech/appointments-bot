# /etc/systemd/system/appbot.service
[Unit]
Description=Telegram appointments bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=appbot
WorkingDirectory=/opt/appointments-bot
EnvironmentFile=/opt/appointments-bot/.env
ExecStart=/opt/appointments-bot/.venv/bin/python -m appbot
Restart=always
RestartSec=5
# Мінімальне посилення ізоляції
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/appointments-bot/data

[Install]
WantedBy=multi-user.target
